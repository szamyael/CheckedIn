# Copy from backend/supabase/.env.example
# Only SUPABASE_URL and SUPABASE_ANON_KEY are required in the mobile app.
# Veryfi credentials must be set on Supabase (edge functions), not called from the client:
#   cd backend && supabase secrets set VERYFI_CLIENT_ID=... VERYFI_USERNAME=... VERYFI_API_KEY=...

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

VERYFI_CLIENT_ID=
VERYFI_USERNAME=
VERYFI_API_KEY=

GOOGLE_MAPS_API_KEY=
